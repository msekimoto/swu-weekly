# Criado no Discord Developer Portal. Nunca envie este valor ao Git.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Para registrar comandos instantaneamente no servidor de testes. Opcional em produção.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# O torneio de teste informado inicialmente.
MELEE_TOURNAMENT_ID=457371
POLL_INTERVAL_SECONDS=30
ROUND_DURATION_MINUTES=60
TIMEZONE=America/Sao_Paulo
# Ao iniciar, publica a rodada que já estiver ativa. Use false para observar sem publicar.
ANNOUNCE_ON_START=true
# Connection string completa do Neon, incluindo usuário, senha e nome do banco. Obrigatória.
DATABASE_URL=
# Somente para Azure Container Apps: a mesma URL em Base64. Não defina as duas.
DATABASE_URL_BASE64=
